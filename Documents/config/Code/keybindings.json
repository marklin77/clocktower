[
   { "key": "ctrl+k ,", "command": "workbench.action.quickOpen" }, { "key": "cmd+p", "command": "-workbench.action.quickOpen" },
   { "key": "ctrl+k s", "command": "workbench.action.openGlobalKeybindings" }, { "key": "cmd+k cmd+s", "command": "-workbench.action.openGlobalKeybindings" },
   { "key": "ctrl+k e", "command": "workbench.view.explorer" },
   { "key": "ctrl+k p", "command": "workbench.action.showCommands" }, { "key": "shift+cmd+p", "command": "-workbench.action.showCommands" },
   { "key": "ctrl+k n", "command": "workbench.action.files.newFile"},
   { "key": "ctrl+k [", "command": "workbench.action.previousEditorInGroup"},
   { "key": "ctrl+k ]", "command": "workbench.action.nextEditorInGroup" },
   { "key": "ctrl+k g", "command": "simpleBrowser.show", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },
   { "key": "ctrl+k i", "command": "workbench.action.chat.toggle", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },
   { "key": "ctrl+k ,", "command": "workbench.action.showAllEditors", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },

   { "key": "space w v", "command": "workbench.action.splitEditor", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },
   { "key": "space w s", "command": "workbench.action.splitEditorDown", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },
   { "key": "space w h", "command": "workbench.action.navigateLeft", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },
   { "key": "space w l", "command": "workbench.action.navigateRight", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },
   { "key": "space w j", "command": "workbench.action.navigateDown", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },
   { "key": "space w k", "command": "workbench.action.navigateUp", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },
   { "key": "space w w", "command": "workbench.action.closeActiveEditor", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },
   { "key": "space w [", "command": "workbench.action.previousEditorInGroup", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },
   { "key": "space w ]", "command": "workbench.action.nextEditorInGroup", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },
   { "key": "space b b", "command": "workbench.action.toggleSidebarVisibility", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },
   { "key": "space b e", "command": "workbench.view.explorer", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)"},
   { "key": "space b x", "command": "workbench.view.extensions", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },

   { "key": "space g", "command": "simpleBrowser.show", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },
   { "key": "space i", "command": "workbench.action.chat.toggle", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },
   { "key": "space ,", "command": "workbench.action.showAllEditors", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },

   { "key": "ctrl+w v",  "command": "workbench.action.splitEditor"},
   { "key": "ctrl+w s",  "command": "workbench.action.splitEditorDown"},
   { "key": "ctrl+w h",  "command": "workbench.action.navigateLeft" },
   { "key": "ctrl+w l",  "command": "workbench.action.navigateRight" },
   { "key": "ctrl+w j",  "command": "workbench.action.navigateDown" },
   { "key": "ctrl+w k",  "command": "workbench.action.navigateUp" },
   { "key": "ctrl+w w",  "command": "workbench.action.closeActiveEditor" },

   // Explore
   { "key": "A", "command": "workbench.action.addRootFolder",    "when": "explorerViewletFocus && !inputFocus"},
   { "key": "R", "command": "workbench.action.removeRootFolder", "when": "explorerViewletFocus && !inputFocus"},

   // sidebar
   { "key": "ctrl+k b",  "command": "workbench.action.toggleSidebarVisibility" },
   { "key": "space w h", "command": "workbench.action.navigateLeft",  "when": "sideBarFocus && !inputFocus" },
   { "key": "space w l", "command": "workbench.action.navigateRight", "when": "sideBarFocus && !inputFocus" },
   { "key": "space b e", "command": "workbench.view.explorer",        "when": "sideBarFocus && !inputFocus" },
   { "key": "space b x", "command": "workbench.view.extensions",      "when": "sideBarFocus && !inputFocus" },
]