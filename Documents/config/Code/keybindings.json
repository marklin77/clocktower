[
   { "key": "ctrl+k ctrl+o", "command": "workbench.action.quickOpen" },             { "key": "cmd+p", "command": "-workbench.action.quickOpen" },
   { "key": "ctrl+k ctrl+s", "command": "workbench.action.openGlobalKeybindings" }, { "key": "cmd+k cmd+s", "command": "-workbench.action.openGlobalKeybindings" },
   { "key": "ctrl+k ctrl+e", "command": "workbench.view.explorer" },                { "key": "ctrl-k ctrl+e", "command": "workbench.action.toggleSidebarVisibility", "when": "explorerViewletFocus"},
   { "key": "ctrl+k ctrl+p", "command": "workbench.action.showCommands" },          { "key": "shift+cmd+p", "command": "-workbench.action.showCommands" },
   // { "key": "ctrl+k ctrl+n", "command": "workbench.action.files.newUntitledFile"},
   { "key": "ctrl+k ctrl+n", "command": "workbench.action.files.openFile"},
   { "key": "ctrl+[",        "command": "workbench.action.previousEditorInGroup"},
   { "key": "ctrl+]",        "command": "workbench.action.nextEditorInGroup" },
   { "key": "ctrl+k ctrl+g", "command": "simpleBrowser.show"},
   { "key": "ctrl+k ctrl+i", "command": "workbench.action.chat.toggle"},
   { "key": "ctrl+k ctrl+,", "command": "workbench.action.showAllEditors"},
   { "key": "ctrl+k ctrl+w", "command": "workbench.action.closeActiveEditor" },
   { "key": "ctrl+k ctrl+x", "command": "workbench.view.extensions"},               { "key": "ctrl+k ctrl+x", "command": "workbench.action.toggleSidebarVisibility", "when": "sideBarFocus && activeViewlet == 'workbench.view.extensions'" },
   { "key": "ctrl+k ctrl+t", "command": "workbench.action.terminal.toggleTerminal"},

   { "key": "ctrl+w ctrl+v",  "command": "workbench.action.splitEditor"},
   { "key": "ctrl+w ctrl+s",  "command": "workbench.action.splitEditorDown"},
   { "key": "ctrl+w ctrl+h",  "command": "workbench.action.navigateLeft" },
   { "key": "ctrl+w ctrl+l",  "command": "workbench.action.navigateRight" },
   { "key": "ctrl+w ctrl+j",  "command": "workbench.action.navigateDown" },
   { "key": "ctrl+w ctrl+k",  "command": "workbench.action.navigateUp" },
   { "key": "ctrl+w ctrl+w",  "command": "workbench.action.joinTwoGroups"},

   { "key": "ctrl+m ctrl+c",  "command": "matlab.openCommandWindow", "when": "editorLangId == matlab"},
   
   { "key": "space w v", "command": "workbench.action.splitEditor", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },
   { "key": "space w s", "command": "workbench.action.splitEditorDown", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },
   { "key": "space w h", "command": "workbench.action.navigateLeft", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },
   { "key": "space w l", "command": "workbench.action.navigateRight", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },
   { "key": "space w j", "command": "workbench.action.navigateDown", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },
   { "key": "space w k", "command": "workbench.action.navigateUp", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },
   { "key": "space w w", "command": "workbench.action.joinTwoGroups", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },
   { "key": "space w [", "command": "workbench.action.previousEditorInGroup", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },
   { "key": "space w ]", "command": "workbench.action.nextEditorInGroup", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },
   { "key": "space w b", "command": "workbench.action.toggleSidebarVisibility", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },

   { "key": "space m c", "command": "matlab.openCommandWindow", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },
   
   { "key": "space g", "command": "simpleBrowser.show", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },
   { "key": "space i", "command": "workbench.action.chat.toggle", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },
   { "key": "space ,", "command": "workbench.action.showAllEditors", "when": "neovim.mode == 'normal' && (editorTextFocus || !inputFocus)" },

   { "key": "ctrl+\\", "command": "editor.action.showHover",               "when": "editorLangId == systemverilog"},
   {
      "key": "ctrl+shift+\\",
      "command": "editor.action.referenceSearch.trigger",
      "when": "editorLangId == systemverilog"
   }
]